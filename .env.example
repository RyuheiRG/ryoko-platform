# Ryoko platform — local development environment
# Copy to `.env` and adjust. Never commit `.env`.
POSTGRES_USER=ryoko
POSTGRES_PASSWORD=ryoko
POSTGRES_DB=ryoko

# Shared auth (all three services must use the same secret/issuer/audience)
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=ryoko-content-api
JWT_AUDIENCE=ryoko-admin
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://ryoko:ryoko@localhost:5432/ryoko
REDIS_URL=redis://localhost:6379/0

# Content API
CMS_API_TOKEN=dev-cms-api-token-0123456789abcdef
WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef
WEBHOOK_URL=http://localhost:8001/v1/events
MEDIA_STORAGE=local
MEDIA_DIR=media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/media
PUBLIC_SITE_URL=http://localhost:4321
PREVIEW_BASE_URL=http://localhost:4321
ENABLE_SCHEDULER=true
SEED_ADMIN_EMAIL=hola@ryuheirg.dev
SEED_ADMIN_PASSWORD=ryoko-dev-password
SEED_ADMIN_NAME=Ricardo Reyes Gómez
SEED_ADMIN_ALIAS=Ryoko

# Metrics API
SITE_ID=ryoko
SITE_KEY=dev-site-key
IP_HASH_SALT=dev-ip-salt
RETENTION_DAYS=90
SEED_DEMO_EVENTS=false

# Webhook API
MAX_ATTEMPTS=5
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=15
MAX_BODY_BYTES=1048576
TIMESTAMP_TOLERANCE_SECONDS=300
RETRY_SCHEDULE_SECONDS=60,300,900,3600,21600
# N8N_WEBHOOK_URL=
# N8N_SHARED_SECRET=
# VERCEL_DEPLOY_HOOK_URL=
# DISCORD_WEBHOOK_URL=

# Admin UI (Vite build-time variables)
VITE_CONTENT_API_URL=http://localhost:8000
VITE_WEBHOOK_API_URL=http://localhost:8001
VITE_METRICS_API_URL=http://localhost:8002/graphql

# Shared
ENVIRONMENT=local
LOG_LEVEL=INFO
ERROR_BASE_URL=http://localhost:8000/errors
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:8080,https://cms.ryuheirg.dev
