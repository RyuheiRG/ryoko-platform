# Ryoko Metrics API — copy to services/metrics-api/.env or use the monorepo root `.env`.
DATABASE_URL=postgresql+asyncpg://ryoko:ryoko@localhost:5432/ryoko
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=ryoko-content-api
JWT_AUDIENCE=ryoko-admin
SITE_ID=ryoko
SITE_KEY=dev-site-key
IP_HASH_SALT=dev-ip-salt
RETENTION_DAYS=90
SEED_DEMO_EVENTS=false
ENVIRONMENT=local
LOG_LEVEL=INFO
ERROR_BASE_URL=http://localhost:8002/errors
CORS_ORIGINS=https://ryuheirg.dev,https://www.ryuheirg.dev,https://cms.ryuheirg.dev,http://localhost:4321,http://localhost:5173
