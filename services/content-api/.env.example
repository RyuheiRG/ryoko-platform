# Ryoko Content API — copy to services/content-api/.env or use the monorepo root `.env`.
DATABASE_URL=postgresql+asyncpg://ryoko:ryoko@localhost:5432/ryoko
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=ryoko-content-api
JWT_AUDIENCE=ryoko-admin
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CMS_API_TOKEN=dev-cms-api-token-0123456789abcdef
WEBHOOK_URL=http://localhost:8001/v1/events
WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef
MEDIA_STORAGE=local
MEDIA_DIR=media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/media
# MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MEDIA_BUCKET=ryoko-media
# MEDIA_ACCESS_KEY=
# MEDIA_SECRET_KEY=
PUBLIC_SITE_URL=http://localhost:4321
PREVIEW_BASE_URL=http://localhost:4321
ENABLE_SCHEDULER=true
SEED_ADMIN_EMAIL=hola@ryuheirg.dev
SEED_ADMIN_PASSWORD=ryoko-dev-password
SEED_ADMIN_NAME=Ricardo Reyes Gómez
SEED_ADMIN_ALIAS=Ryoko
ENVIRONMENT=local
LOG_LEVEL=INFO
ERROR_BASE_URL=http://localhost:8000/errors
CORS_ORIGINS=http://localhost:5173,https://cms.ryuheirg.dev
