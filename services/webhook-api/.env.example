# Ryoko Webhook API — copy to services/webhook-api/.env or use the monorepo root `.env`.
DATABASE_URL=postgresql+asyncpg://ryoko:ryoko@localhost:5432/ryoko
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=ryoko-content-api
JWT_AUDIENCE=ryoko-admin
WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef
MAX_ATTEMPTS=5
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=15
MAX_BODY_BYTES=1048576
TIMESTAMP_TOLERANCE_SECONDS=300
RETRY_SCHEDULE_SECONDS=60,300,900,3600,21600
# N8N_WEBHOOK_URL=https://n8n.example.com/webhook/ryoko
# N8N_SHARED_SECRET=
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
ENVIRONMENT=local
LOG_LEVEL=INFO
ERROR_BASE_URL=http://localhost:8001/errors
CORS_ORIGINS=http://localhost:5173,https://cms.ryuheirg.dev
